generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  user
  admin
}

enum PatentStatus {
  pending_ai
  pending_admin
  approved
  declined
  draft
}

enum ReviewStage {
  ai_filter
  admin_review
}

enum ReviewDecision {
  pass
  fail
  flagged
}


model User {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(user)
  createdBy    BigInt?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  submittedPatents Patent[]       @relation("PatentSubmitter")
  reviewsGiven     PatentReview[] @relation("Reviewer")
  inventorProfile  Inventor?      @relation("UserInventor")
  refreshTokens    RefreshToken[]

  // Which admin created this account. Null for self-registered users and the
  // seeded root admin. Restrict so an audit trail can't be erased by deleting
  // the creator.
  creator      User?  @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  createdUsers User[] @relation("UserCreatedBy")

  @@map("USER")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  // SHA-256 of the token, never the token itself: a DB leak must not hand out
  // usable sessions. Fast hashing is fine here (unlike passwords) because the
  // token is high-entropy random, not guessable.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  // Set when rotated; presenting an already-rotated token signals theft.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_token_user")
  @@index([expiresAt], name: "idx_refresh_token_expires")
  @@map("REFRESH_TOKEN")
}

model Patent {
  id            BigInt       @id @default(autoincrement())
  title         String       @db.VarChar(500)
  abstract      String       @db.Text
  specification String       @db.Text

  /// Object-store key of the submitted document, e.g.
  /// "patents/3/2f1c.../spec.pdf". A key, not a URL: presigned URLs expire,
  /// so storing one would hand out a reference that is dead within the hour.
  ///
  /// Unique because two patents sharing a key makes document deletion unsafe:
  /// deleting a draft would destroy the object an approved patent still points
  /// at, which is exactly the tampering the draft-only delete rule prevents.
  documentKey   String?      @unique @map("document_key") @db.Text

  /// Superseded by documentKey. Kept nullable so the column can be dropped in
  /// a later migration without a data-loss step; nothing writes it.
  s3FileUrl     String?      @map("s3_file_url") @db.Text

  /// Bumped only when the *content* changes (title/abstract/specification/
  /// document). Category and inventor edits leave it alone: it is half of the
  /// downstream idempotency key, and churning it forces pointless re-indexing.
  version       Int          @default(1)

  publicationNumber String?  @unique @map("publication_number") @db.VarChar(64)
  jurisdiction      String?  @db.VarChar(8)

  status        PatentStatus @default(draft)
  submittedBy   BigInt       @map("submitted_by")
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  //
  // Restrict, not SetNull: submittedBy is NOT NULL, so SET NULL was
  // unsatisfiable and would have raised an FK error at runtime the first time
  // anyone deleted a user with patents. Restrict also keeps the audit trail —
  // you cannot erase who submitted a patent by deleting the account.
  submitter  User             @relation("PatentSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  reviews    PatentReview[]
  inventors  PatentInventor[]
  categories PatentCategory[]

  @@index([status], name: "idx_patent_status")
  @@index([submittedBy], name: "idx_patent_submitted_by")
  @@index([submittedBy, status], name: "idx_patent_submitter_status")
  @@index([createdAt], name: "idx_patent_created_at")
  @@map("PATENT")
}

model PatentReview {
  id                BigInt          @id @default(autoincrement())
  patentId          BigInt          @map("patent_id")
  reviewerId        BigInt?         @map("reviewer_id")
  reviewStage       ReviewStage     @map("review_stage")
  decision          ReviewDecision?
  aiConfidenceScore Decimal?        @map("ai_confidence_score") @db.Decimal(5, 2)
  comments          String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  patent   Patent @relation(fields: [patentId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([patentId], name: "idx_patent_review_patent")
  @@map("PATENT_REVIEW")
}

model Inventor {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt?  @unique @map("user_id") // @unique makes it a 1-to-1 or 1-to-0 relation
  fullName     String   @map("full_name") @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  organization String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user    User?            @relation("UserInventor", fields: [userId], references: [id], onDelete: SetNull)
  patents PatentInventor[]

  @@map("INVENTOR")
}

model PatentInventor {
  patentId      BigInt @map("patent_id")
  inventorId    BigInt @map("inventor_id")
  inventorOrder Int    @default(1) @map("inventor_order")

  // Relations
  patent   Patent   @relation(fields: [patentId], references: [id], onDelete: Cascade)
  inventor Inventor @relation(fields: [inventorId], references: [id], onDelete: Cascade)

  // Composite Primary Key
  @@id([patentId, inventorId])
  @@map("PATENT_INVENTOR")
}

model Category {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(255)

  // Relations
  patents PatentCategory[]

  @@map("CATEGORY")
}

model PatentCategory {
  patentId   BigInt @map("patent_id")
  categoryId BigInt @map("category_id")

  // Relations
  patent   Patent   @relation(fields: [patentId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Composite Primary Key
  @@id([patentId, categoryId])
  @@map("PATENT_CATEGORY")
}
/// Reliable event publication.
///
/// A row here is written in the SAME transaction as the state change it
/// describes, so the event can never diverge from committed data. The relay
/// (src/workers/outboxRelay.js) publishes unpublished rows to Kafka and marks
/// them. That split means delivery is at-least-once: the relay can duplicate,
/// never lose. Consumers must be idempotent on (patentId, version).
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   BigInt    @map("aggregate_id")
  eventType     String    @map("event_type") @db.VarChar(128)
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz

  /// Set when a relay takes ownership of the row, cleared if publishing fails.
  /// Publishing happens OUTSIDE a database transaction (a Kafka round trip must
  /// never be held inside one), so a row lock cannot be what stops a second
  /// relay picking up the same event — this claim marker is. Stale claims are
  /// reclaimed after CLAIM_TIMEOUT so a crashed relay does not strand events.
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz

  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.Text

  @@index([aggregateType, aggregateId], name: "idx_outbox_aggregate")
  @@map("OUTBOX_EVENT")
}

/// Replay protection for mutating requests.
///
/// Keyed by (userId, endpoint, key) so one user's key cannot collide with
/// another's. requestHash lets a same-key-different-body call be rejected as a
/// 409 rather than silently returning someone else's answer.
model IdempotencyKey {
  key            String   @db.VarChar(255)
  userId         BigInt   @map("user_id")
  endpoint       String   @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, endpoint, key])
  @@index([createdAt], name: "idx_idempotency_created")
  @@map("IDEMPOTENCY_KEY")
}
