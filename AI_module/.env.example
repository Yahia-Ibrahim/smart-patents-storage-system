# AI service configuration.
#
# Only needed to run this service on its own (AI_module/docker-compose.yml or
# `python -m app.main`). Inside the integrated stack the root docker-compose.yml
# supplies all of these directly, and this file is not read.
#
# Every value below is read through os.getenv with an inline default; there is
# no central settings module (app/config/settings.py is empty).

# --- Kafka -------------------------------------------------------------------
# Use 127.0.0.1:29092 from the host and kafka:9092 from inside the network.
# Not "localhost": Docker publishes on IPv4 only and localhost resolves to ::1
# first, which produces intermittent connection failures.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
REPORT_TOPIC=Notifications.similarity-report

# --- Embedding cache (Postgres) ----------------------------------------------
# Either DATABASE_URL, or the DB_* parts below. DATABASE_URL wins if set.
# Note the psycopg2 driver prefix, which SQLAlchemy requires.
DATABASE_URL=postgresql+psycopg2://patents:patents@127.0.0.1:5433/ai_db
# DB_USER=ai
# DB_PASSWORD=ai
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=ai_db

# --- Vector store (Qdrant) ---------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=patents

# --- Object storage (MinIO) --------------------------------------------------
# Used for documents delivered as s3://bucket/key URIs. Plain http/https URLs in
# fileUrl are still downloaded directly and need none of this.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=admin123123

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Must match the model's output dimensions, or Qdrant rejects the first upsert.
EMBEDDING_DIM=384

# Where downloaded documents are written before text extraction.
TMP_DIR=/tmp/patents
