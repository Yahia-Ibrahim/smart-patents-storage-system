PORT=5000
NODE_ENV=development

POSTGRES_USER=patents
POSTGRES_PASSWORD=patents
POSTGRES_DB=patents
DATABASE_URL=postgresql://patents:patents@localhost:5433/patents?schema=public

# Used by `npm test`. Must be a DIFFERENT database: the suite truncates every
# table between tests and would wipe your dev data otherwise.
TEST_DATABASE_URL=postgresql://patents:patents@localhost:5433/patents_test?schema=public

# Generate a unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-secret
# Access token lifetime. Keep it short: access tokens cannot be revoked before
# they expire, so the refresh token is what carries a long-lived session.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Initial administrator, created by `npm run prisma:seed`.
# Admins cannot self-register; this is how the first one exists.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-strong-password

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123123

# Kafka (KRaft mode, no ZooKeeper). Any valid base64-url, 22-character string;
# only matters if you want a stable cluster ID across `docker compose down`
# without `-v`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
KAFKA_CLUSTER_ID=UM2O03kYNS43ch8HyqJfsg
