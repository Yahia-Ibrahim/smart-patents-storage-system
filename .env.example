# Host addresses use 127.0.0.1, not localhost, on purpose.
# Docker publishes ports on 0.0.0.0 (IPv4 only), while Node resolves
# "localhost" to ::1 first — which produces intermittent ECONNRESET/connect
# timeouts against Postgres, MinIO, and Kafka that look like flaky services.
PORT=5000
NODE_ENV=development

POSTGRES_USER=patents
POSTGRES_PASSWORD=patents
POSTGRES_DB=patents
DATABASE_URL=postgresql://patents:patents@127.0.0.1:5433/patents?schema=public
# Max Postgres connections this process holds. Every API replica and the relay draw
# from the same server budget, so keep it modest.
DATABASE_POOL_MAX=10

# Used by `npm test`. Must be a DIFFERENT database: the suite truncates every
# table between tests and would wipe your dev data otherwise.
TEST_DATABASE_URL=postgresql://patents:patents@127.0.0.1:5433/patents_test?schema=public

# Generate a unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# bcrypt work factor. Leave unset in real environments - it defaults to 12, and to 4
# under NODE_ENV=test so the suite is not dominated by KDF time.
# BCRYPT_COST=12
JWT_SECRET=replace-me-with-a-random-secret
# Access token lifetime. Keep it short: access tokens cannot be revoked before
# they expire, so the refresh token is what carries a long-lived session.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Initial administrator, created by `npm run prisma:seed`.
# Admins cannot self-register; this is how the first one exists.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-strong-password

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123123

# Kafka (KRaft mode, no ZooKeeper). Any valid base64-url, 22-character string;
# only matters if you want a stable cluster ID across `docker compose down`
# without `-v`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
KAFKA_CLUSTER_ID=UM2O03kYNS43ch8HyqJfsg

# --- Object storage (MinIO in dev, S3-compatible anywhere) -------------------
# The backend never streams uploads: it issues presigned URLs and the client
# PUTs straight to storage. S3_ENDPOINT is http://minio:9000 inside compose.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=patents
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=admin123123
# MinIO serves buckets as a path segment; real S3 wants this false.
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=52428800
ALLOWED_UPLOAD_TYPES=application/pdf,text/plain

# --- Messaging --------------------------------------------------------------
# The API never publishes to Kafka directly; it writes to the OUTBOX_EVENT
# table and the relay process (`npm run relay`) does the publishing. That is
# why a broker outage cannot take the API down.
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_CLIENT_ID=patents-backend
PATENT_EVENTS_TOPIC=patents.events
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# --- AI service integration --------------------------------------------------
#
# The AI service (AI_module/) is a Kafka consumer owned by another team. The
# backend publishes these three topics in the flat shape its pydantic DTOs
# parse, and consumes the similarity report it publishes back.
#
# These names are hardcoded on its side (KafkaPatentConsumer.TOPIC_HANDLERS and
# NotificationProducer), so they are only "configurable" in the sense that both
# sides have to move together.
AI_SUBMITTED_TOPIC=Patents.submitted
AI_APPROVED_TOPIC=Patents.approved
AI_REJECTED_TOPIC=Patents.rejected
AI_REPORT_TOPIC=Notifications.similarity-report

# Consumer group for the report consumer (`npm run consumer`). Instances of that
# process share this group and divide the partitions between them.
AI_REPORT_GROUP_ID=patents-backend-ai-reports

# The AI service's own database, created on the shared Postgres instance by
# docker/postgres-init. Consumed by docker-compose, not by the Node config.
AI_POSTGRES_DB=ai_db
QDRANT_COLLECTION=patents
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Must match the embedding model's output dimensions.
EMBEDDING_DIM=384

# --- HTTP -------------------------------------------------------------------
# Comma-separated allowlist. Empty reflects any origin, which config/env.js
# refuses to allow when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb
SWAGGER_SERVER_URL=
